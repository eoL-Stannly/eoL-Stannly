{
  "name": "llm-agents-office",
  "version": "1.0.0",
  "description": "LLM Agents Office - Visual UI showing AI agents as cartoon characters in an office workspace with Ralph Wiggum autonomous bash loop",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:client": "vite",
    "dev:server": "node src/server/index.js",
    "build": "vite build",
    "preview": "vite preview",
    "ralph": "bash ralph_loop.sh",
    "ralph:monitor": "bash ralph_monitor.sh"
  },
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "ws": "^8.16.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "concurrently": "^8.2.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.1",
    "vite": "^5.0.12"
  }
}
